{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "e2e/**/*.ts",
    "fixtures/react18-compat/vitest.setup.ts",
    "packages/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.react18.config.ts"
  ]
}
